{
    "name": "My Fullscreen App",
    "short_name": "My App",
    "description": "Fullscreen landscape PWA",
    "start_url": "./index.html",
    "scope": "./",
    "display": "standalone",
    "display_override":["window-controls-overlay", "standalone"],
    "orientation": "any",
    "background_color": "#000000",
    "theme_color": "#000000",
    "icons": [
        {
            "src": "./icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "./icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        }
    ]
}
